  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-alwayswithyou-rules \"jest --runInBand --config jest.rules.config.js\"",
