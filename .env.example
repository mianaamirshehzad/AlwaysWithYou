# Firebase Web configuration
# Copy this file to .env and fill in the values from the Firebase Console:
# Project settings -> General -> Your apps -> Web app (SDK setup and configuration snippet).
#
# IMPORTANT:
# - The local .env is git-ignored and MUST NOT be committed.
# - These EXPO_PUBLIC_* values are inlined into the app bundle at build time.
#   They are Firebase WEB CLIENT config values, designed to be embedded in a
#   client app (not secret credentials).
# - The source (src/services/firebase.ts) reads them via STATIC
#   `process.env.EXPO_PUBLIC_*` expressions so Expo/Metro inlines the values.
#   Do NOT switch to dynamic access (e.g. process.env[key]) as it is not
#   inlined and will be empty in standalone builds.

# Required by every EAS build where Firebase must work.
# These six variables must ALSO be configured in the EAS project environment
# that matches the build profile (e.g. `preview`) with PLAINTEXT visibility:
#   eas env:set --environment preview <NAME> --visibility plaintext
# See the EAS environment variables docs: https://docs.expo.dev/eas/environment-variables/

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
